; Engine configuration file.
; Eternal Ascension — 2D open-world xianxia cultivation sandbox.
; Input actions are registered in code (core/settings.gd) so bindings stay rebindable.

config_version=5

[application]

config/name="Eternal Ascension"
config/description="A 2D open-world xianxia cultivation sandbox RPG."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/show_image=false

[autoload]

Log="*res://core/log.gd"
Bus="*res://core/bus.gd"
Rng="*res://core/rng.gd"
DB="*res://core/db.gd"
Clock="*res://core/clock.gd"
Settings="*res://core/settings.gd"
Save="*res://core/save.gd"
Game="*res://core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.07, 1)
